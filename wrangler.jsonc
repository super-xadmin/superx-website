{
  // SUPERX AI website on Cloudflare Workers.
  // Every deploy first runs build/build.py, which makes the web pages in public/ from content/
  // (the files edited in the back office, Pages CMS). worker.js sends the contact form to Lark.
  "name": "superx-website",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "python3 build/build.py"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
